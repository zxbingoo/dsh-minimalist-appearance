{
  "name": "dsh-minimalist-appearance",
  "version": "0.2.14",
  "private": true,
  "type": "module",
  "description": "Change DeepSeek Harness colors and backgrounds without changing its typography or layout.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/zxbingoo/dsh-minimalist-appearance.git" },
  "homepage": "https://github.com/zxbingoo/dsh-minimalist-appearance#readme",
  "bugs": { "url": "https://github.com/zxbingoo/dsh-minimalist-appearance/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "theme", "appearance"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "backgrounds.js", "client.js", "src/*.js", "assets/*.png", "assets/README.md", "RELEASE_NOTES.md", "build.mjs", "test/*.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-theme", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-connection"]
    }
  }
}
